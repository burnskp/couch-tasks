#compdef ct

_ct_commands=(
  'add:Add a task to a project'
  'quick:Quick add a task to inbox'
  'list:List pending tasks'
  'completed:List completed tasks for a project'
  'clear-completed:Delete completed tasks'
  'done:Mark tasks done'
  'undone:Restore completed tasks to pending'
  'delete:Delete tasks'
  'move:Move a task to another project'
  'update:Update task fields without opening an editor'
  'due:Set or clear due dates'
  'remind:Turn reminders on or off'
  'reorder:Reorder a pending task within its project'
  'edit:Edit a task in $EDITOR'
  'note:Append a note to a task'
  'show:Show task details'
  'review:Review tasks project by project'
  'sync:Sync tasks'
)

_ct_projects() {
  local -a projects
  projects=(${(f)"$(_call_program projects ct _complete projects 2>/dev/null)"})
  _describe -t projects 'project' projects
}

_ct() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '1:command or project:->command_or_project' \
    '*::arg:->args'

  case $state in
    command_or_project)
      _alternative \
        'commands:command: _describe -t commands command _ct_commands' \
        'projects:project:_ct_projects'
      ;;
    args)
      case $line[1] in
        add)
          if [[ $words[CURRENT-1] == --due ]]; then
            _message 'due date'
          elif [[ $PREFIX == -* ]]; then
            _values 'option' '--due[set the due date]' '--remind[turn the reminder on]'
          elif (( CURRENT == 2 )); then
            _ct_projects
          else
            _message 'task title'
          fi
          ;;
        list)
          _arguments \
            '--notes[show notes under tasks]' \
            '--json[output tasks as JSON]' \
            '--due[list only tasks with due dates]' \
            '(--relative)--absolute[show due dates as local date and time]' \
            '(--absolute)--relative[show due dates as time remaining]' \
            '*:project:_ct_projects'
          ;;
        completed)
          _arguments '--json[output tasks as JSON]' '*:project:_ct_projects'
          ;;
        clear-completed)
          _ct_projects
          ;;
        move)
          if (( CURRENT == 3 )); then
            _ct_projects
          else
            _message 'task id'
          fi
          ;;
        done|undone|delete|edit|show)
          _message 'task id'
          ;;
        update)
          _arguments \
            '1:task id:' \
            '--project[set project]:project:_ct_projects' \
            '--title[set title]:title:' \
            '--notes[replace notes]:notes:' \
            '--due[set the due date; empty clears it]:due date:' \
            '(--no-remind)--remind[turn the reminder on]' \
            '(--remind)--no-remind[turn the reminder off]'
          ;;
        due)
          _arguments \
            '--clear[clear the due date and reminder]' \
            '*:task id or due date:'
          ;;
        remind)
          if (( CURRENT == 2 )); then
            _message 'task id'
          else
            _alternative \
              'states:state:(on off)' \
              'ids:task id: '
          fi
          ;;
        reorder)
          if (( CURRENT == 2 )); then
            _message 'task id'
          else
            _message 'position'
          fi
          ;;
        note)
          if (( CURRENT == 2 )); then
            _message 'task id'
          else
            _message 'note'
          fi
          ;;
        quick)
          if [[ $words[CURRENT-1] == --due ]]; then
            _message 'due date'
          elif [[ $PREFIX == -* ]]; then
            _values 'option' '--due[set the due date]' '--remind[turn the reminder on]'
          else
            _message 'task title'
          fi
          ;;
        review)
          _arguments \
            '--days[review tasks not reviewed in this many days]:days:' \
            '(--list)--tasks[review one task at a time]' \
            '(--tasks)--list[review each project as a numbered list]'
          ;;
        sync)
          _arguments \
            '(-v --verbose)'{-v,--verbose}'[show the resulting sync checkpoint]' \
            '--url[sync server URL]:url:' \
            '--cert[client certificate path]:certificate file:_files' \
            '--key[client private key path]:key file:_files' \
            '--ca[server CA certificate path]:CA file:_files'
          ;;
      esac
      ;;
  esac
}

_ct "$@"
